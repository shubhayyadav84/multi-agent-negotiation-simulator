# Express Backend Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection
# Format: postgres://<user>:<password>@<ep-something>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# AI Service (FastAPI) URL
AI_SERVICE_URL=http://localhost:8000

# Primary & Secondary AI Provider Keys (Optional direct fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Firebase Admin SDK Configuration (for Backend ID Token Verification)
# Option A: Discrete variables (Recommended for Render / Cloud hosting)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: Full Service Account JSON (Alternative)
FIREBASE_SERVICE_ACCOUNT_KEY=

